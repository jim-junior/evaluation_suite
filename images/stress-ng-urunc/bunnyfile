#syntax=harbor.nbfc.io/nubificus/bunny:latest
version: v0.1

platforms:
  framework: linux
  monitor: qemu
  architecture: x86

rootfs:
  from: jimjuniorb/stress-ng-benchmark:0.1
  type: raw
  include:
    - from: harbor.nbfc.io/nubificus/urunit:latest
      source: /urunit
      destination: /urunit

kernel:
  from: local
  path: bzImage


entrypoint: ["/urunit", "/usr/local/bin/stress-ng-wrapper"]